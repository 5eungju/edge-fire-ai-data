          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_upload_api_v1_storage_jobs_post"
      },
      "GasMetrics": {
        "properties": {
          "CO": {
            "type": "number",
            "title": "Co",
            "example": 45.2
          },
          "H2": {
            "type": "number",
            "title": "H2",
            "example": 12.1
          },
          "VOC": {
            "type": "number",
            "title": "Voc",
            "example": 110.5
          }
        },
        "type": "object",
        "required": [
          "CO",
          "H2",
          "VOC"
        ],
        "title": "GasMetrics"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TelemetryRequest": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id",
            "example": "NODE_WUI_0102"
          },
          "sequence_no": {
            "type": "integer",
            "title": "Sequence No",
            "example": 1042
          },
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "gas_data": {
            "$ref": "#/components/schemas/GasMetrics"
          },
          "environment": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment"
          },
          "camera_azimuth": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Azimuth",
            "example": 185.4
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "sequence_no",
          "gas_data"
        ],
        "title": "TelemetryRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
